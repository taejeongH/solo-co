<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ssafy.travel.itinerary.mapper.TravelItineraryMapper">

	<delete id="deleteByProjectId">
        DELETE FROM project_itinerary_place
        WHERE project_id = #{projectId}
    </delete>
	
	<insert id="insertItineraryPlace">
        INSERT INTO project_itinerary_place (
            project_id,
            day,
            order_no,
            place_id
        ) VALUES (
            #{projectId},
            #{day},
            #{orderNo},
            #{placeId}
        )
    </insert>

</mapper>
