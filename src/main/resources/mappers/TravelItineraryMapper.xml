<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ssafy.mapper.TravelItineraryMapper">

	<delete id="deleteByProjectId">
	    DELETE FROM project_itinerary WHERE project_id = #{projectId}
	</delete>
	
	<insert id="insertItinerary">
	    INSERT INTO project_itinerary
	        (project_id, day, order_no, place_name)
	    VALUES
	    <foreach collection="places" item="p" index="idx" separator=",">
	        (#{projectId}, #{day}, #{idx}, #{p})
	    </foreach>
	</insert>

</mapper>
